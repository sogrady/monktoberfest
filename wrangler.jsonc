{
  "name": "monktoberfest-web",
  "compatibility_date": "2026-06-29",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": true,
  "build": {
    "command": "hugo --gc --minify"
  },
  "routes": [
    {
	"pattern": "web.monktoberfest.com",
	"custom_domain": true
	}
  ],
"assets": {
    "directory": "./public"
  },
  "observability": {
      "enabled": false,
      "head_sampling_rate": 1,
      "logs": {
        "enabled": true,
        "head_sampling_rate": 1,
        "persist": true,
        "invocation_logs": true
      },
      "traces": {
        "enabled": true,
        "persist": true,
        "head_sampling_rate": 1
      }
    }
}
